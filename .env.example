# Anthropic API Configuration (for backend/scripts)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Frontend API Configuration
# -----------------------------
# Primary toggle: VITE_USE_MOCK_API (see also `.env.production` for `pnpm build`)
#
# MODE 1: Mock Mode — unset, true, or 1
#   - No backend required
#
# MODE 2: Backend Mode — false or 0
#   - Backend must be reachable at VITE_API_URL
#
VITE_USE_MOCK_API=true

# Backend API base URL (dev: full URL; production build: /api/v1 behind Nginx)
VITE_API_URL=http://localhost:3001/api/v1
